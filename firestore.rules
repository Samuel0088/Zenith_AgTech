rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function ownerExists() { return loggedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }
    function employeeExists() { return loggedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid)); }
    function legacyExists() { return loggedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profileExists() { return ownerExists() || employeeExists() || legacyExists(); }
    function currentProfile() {
      return ownerExists()
        ? get(/databases/$(database)/documents/owners/$(request.auth.uid)).data
        : employeeExists()
          ? get(/databases/$(database)/documents/employees/$(request.auth.uid)).data
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active(profile) { return profile.get("archived", false) != true && profile.get("accessStatus", "active") != "blocked"; }
    function activeAccount() { return profileExists() && active(currentProfile()); }
    function fullAccessAccount() {
      return loggedIn() && request.auth.token.email in [
        "oarsilva6@gmail.com",
        "leocarrilhom@gmail.com",
        "samuel.vieirafreitas@outlook.com"
      ];
    }
    function isOwner() { return activeAccount() && (!currentProfile().keys().hasAny(["role"]) || currentProfile().role == "admin"); }
    function belongsTo(ownerId) {
      return activeAccount() && (request.auth.uid == ownerId || currentProfile().get("ownerId", "") == ownerId || currentProfile().get("teamId", "") == ownerId);
    }
    function managedEmployee(employeeId) {
      return activeAccount() && (
        (exists(/databases/$(database)/documents/employees/$(employeeId))
          && get(/databases/$(database)/documents/employees/$(employeeId)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/employees/$(employeeId)).data.role in ["employee", "collaborator"]
          && active(get(/databases/$(database)/documents/employees/$(employeeId)).data))
        || (exists(/databases/$(database)/documents/users/$(employeeId))
          && get(/databases/$(database)/documents/users/$(employeeId)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(employeeId)).data.role in ["employee", "collaborator"])
      );
    }
    function employeeStartsActivity() {
      return resource.data.status == "pendente" && request.resource.data.status == "em_andamento"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "startedAt", "updatedAt"]);
    }
    function employeeCompletesActivity() {
      return resource.data.status == "em_andamento" && request.resource.data.status == "concluida"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "completedAt", "updatedAt"]);
    }
    function validUsageCounts(data) {
      return data.get("diagnosisUses", 0) is int
        && data.get("monitoringUses", 0) is int
        && data.get("reconstruction3dUses", 0) is int
        && data.get("diagnosisUses", 0) >= 0 && data.get("diagnosisUses", 0) <= 3
        && data.get("monitoringUses", 0) >= 0 && data.get("monitoringUses", 0) <= 3
        && data.get("reconstruction3dUses", 0) >= 0 && data.get("reconstruction3dUses", 0) <= 3;
    }
    match /owners/{ownerId} {
      allow create: if loggedIn() && request.auth.uid == ownerId && request.resource.data.email == request.auth.token.email
        && (!request.resource.data.keys().hasAny(["role"]) || request.resource.data.role == "admin")
        && !request.resource.data.keys().hasAny(["document", "phone"]);
      allow read: if loggedIn() && (request.auth.uid == ownerId || (employeeExists() && belongsTo(ownerId)));
      allow update: if isOwner() && request.auth.uid == ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "age", "email", "profileIcon", "city", "state", "phoneMasked", "phoneLast4", "identityProtectionVersion",
          "hectares", "plan", "planName", "updatedAt"
        ]);
      allow update: if loggedIn() && request.auth.uid == ownerId
        && resource.data.keys().hasAny(["document", "phone"])
        && !request.resource.data.keys().hasAny(["document", "phone"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "document", "phone", "documentMasked", "documentLast4", "phoneMasked", "phoneLast4",
          "identityProtectionVersion", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /employees/{employeeId} {
      allow create: if !request.resource.data.keys().hasAny(["document", "phone"]) && (
        (isOwner() && fullAccessAccount() && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.teamId == request.auth.uid && request.resource.data.role in ["employee", "collaborator"])
        || (loggedIn() && request.auth.uid == employeeId && legacyExists()
          && get(/databases/$(database)/documents/users/$(employeeId)).data.role in ["employee", "collaborator"]
          && request.resource.data.role == get(/databases/$(database)/documents/users/$(employeeId)).data.role
          && request.resource.data.ownerId == get(/databases/$(database)/documents/users/$(employeeId)).data.ownerId
          && request.resource.data.teamId == get(/databases/$(database)/documents/users/$(employeeId)).data.teamId
          && request.resource.data.email == get(/databases/$(database)/documents/users/$(employeeId)).data.email)
      );
      allow read: if (loggedIn() && request.auth.uid == employeeId) || (isOwner() && resource.data.ownerId == request.auth.uid);
      allow update: if isOwner() && fullAccessAccount() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "age", "employmentType", "position", "sector", "droneModel",
          "status", "entry", "exit", "hours", "delays", "absences", "lastActivity", "inviteStatus",
          "archived", "archivedAt", "accessStatus", "updatedAt"
        ]);
      allow update: if activeAccount() && request.auth.uid == employeeId
        && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.role == resource.data.role && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "entry", "exit", "hours", "workStartedAt", "workEndedAt", "lastActivity", "updatedAt"
        ]);
      allow update: if loggedIn() && request.auth.uid == employeeId
        && resource.data.keys().hasAny(["document", "phone"])
        && !request.resource.data.keys().hasAny(["document", "phone"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "document", "phone", "documentMasked", "documentLast4", "phoneMasked", "phoneLast4",
          "identityProtectionVersion", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /users/{userId} {
      allow create, update: if false;
      allow update: if loggedIn() && request.auth.uid == userId
        && resource.data.keys().hasAny(["document", "phone"])
        && !request.resource.data.keys().hasAny(["document", "phone"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "document", "phone", "documentMasked", "documentLast4", "phoneMasked", "phoneLast4",
          "identityProtectionVersion", "updatedAt"
        ]);
      allow read: if loggedIn() && (request.auth.uid == userId || (isOwner() && resource.data.ownerId == request.auth.uid));
      allow delete: if loggedIn() && (request.auth.uid == userId || (isOwner() && resource.data.ownerId == request.auth.uid));
    }

    match /farms/{farmId} {
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(["documento_proprietario", "telefone"]);
      allow read: if belongsTo(resource.data.ownerId);
      allow update: if isOwner() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["documento_proprietario", "telefone"]);
      allow update: if isOwner() && resource.data.ownerId == request.auth.uid
        && resource.data.keys().hasAny(["documento_proprietario", "telefone"])
        && !request.resource.data.keys().hasAny(["documento_proprietario", "telefone"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "documento_proprietario", "telefone", "documento_proprietario_mascarado", "telefone_mascarado",
          "documentLast4", "phoneLast4", "identityProtectionVersion", "updatedAt"
        ]);
      allow delete: if isOwner() && resource.data.ownerId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow create: if isOwner() && request.resource.data.ownerId == request.auth.uid && (
        request.resource.data.scope == "general" ||
        (request.resource.data.scope == "individual" && managedEmployee(request.resource.data.assigneeId))
      );
      allow read: if activeAccount() && (resource.data.ownerId == request.auth.uid
        || (resource.data.scope == "general" && belongsTo(resource.data.ownerId))
        || resource.data.assigneeId == request.auth.uid);
      allow update: if isOwner() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow update: if activeAccount() && resource.data.assigneeId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.assigneeId == resource.data.assigneeId
        && (employeeStartsActivity() || employeeCompletesActivity());
      allow delete: if isOwner() && resource.data.ownerId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow create, update: if false;
      allow read, delete: if isOwner() && resource.data.ownerId == request.auth.uid;
    }

    match /featureUsage/{userId} {
      allow read: if activeAccount() && request.auth.uid == userId;
      allow create: if activeAccount() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["diagnosisUses", "monitoringUses", "updatedAt"])
        && validUsageCounts(request.resource.data)
        && request.resource.data.get("diagnosisUses", 0) + request.resource.data.get("monitoringUses", 0) == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if activeAccount() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["diagnosisUses", "monitoringUses", "updatedAt"])
        && validUsageCounts(request.resource.data)
        && request.resource.data.get("diagnosisUses", 0) >= resource.data.get("diagnosisUses", 0)
        && request.resource.data.get("monitoringUses", 0) >= resource.data.get("monitoringUses", 0)
        && request.resource.data.get("diagnosisUses", 0) + request.resource.data.get("monitoringUses", 0)
          == resource.data.get("diagnosisUses", 0) + resource.data.get("monitoringUses", 0) + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /featureUsageDaily/{userId}/days/{dayId} {
      allow read: if activeAccount() && request.auth.uid == userId;
      allow create: if activeAccount() && request.auth.uid == userId
        && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(["diagnosisUses", "monitoringUses", "reconstruction3dUses", "updatedAt"])
        && validUsageCounts(request.resource.data)
        && request.resource.data.get("diagnosisUses", 0) + request.resource.data.get("monitoringUses", 0)
          + request.resource.data.get("reconstruction3dUses", 0) == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if activeAccount() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["diagnosisUses", "monitoringUses", "reconstruction3dUses", "updatedAt"])
        && validUsageCounts(request.resource.data)
        && request.resource.data.get("diagnosisUses", 0) >= resource.data.get("diagnosisUses", 0)
        && request.resource.data.get("monitoringUses", 0) >= resource.data.get("monitoringUses", 0)
        && request.resource.data.get("reconstruction3dUses", 0) >= resource.data.get("reconstruction3dUses", 0)
        && request.resource.data.get("diagnosisUses", 0) + request.resource.data.get("monitoringUses", 0)
          + request.resource.data.get("reconstruction3dUses", 0)
          == resource.data.get("diagnosisUses", 0) + resource.data.get("monitoringUses", 0)
            + resource.data.get("reconstruction3dUses", 0) + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /accountIdentifiers/{claimId} {
      allow get: if loggedIn();
      allow list: if false;
      allow create: if loggedIn()
        && request.resource.data.keys().hasOnly(["userId", "ownerId", "kind", "profileCollection", "createdAt"])
        && request.resource.data.kind in ["document", "phone"]
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.userId == request.auth.uid
          || (isOwner() && request.resource.data.ownerId == request.auth.uid)
        );
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
